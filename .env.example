# Example only. Copy to .env and fill in. Never commit real values.

# Live tier only (pytest -m live, model.adapter=anthropic). The stable tier needs no key.
ANTHROPIC_API_KEY=

# Key for the HMAC fingerprint of vendor bank accounts in the fixture layer (architecture §6.5).
# Any random string works locally; a real deployment would use a managed secret.
AP_PAYMENT_HMAC_KEY=change-me-local-only

# Optional override of any config/app.yaml key, nested with a double underscore, e.g.:
# AP_STORAGE__SQLITE_PATH=/data/ap.db
# AP_MODEL__ADAPTER=anthropic
